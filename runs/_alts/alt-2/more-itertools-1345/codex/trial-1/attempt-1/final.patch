+
+    def test_long_range_inequality(self):
+        stop = 10**30
+        a = mi.numeric_range(0, stop)
+        for args in [
+            (0, stop + 1),  # Different length
+            (1, stop + 1),  # Different start
+            (0, stop * 2, 2),  # Different step, same length
+            (0, -stop, -1),  # Descending, same length
+        ]:
+            with self.subTest(args=args):
+                b = mi.numeric_range(*args)
+                self.assertNotEqual(a, b)
+                self.assertFalse(a == b)
