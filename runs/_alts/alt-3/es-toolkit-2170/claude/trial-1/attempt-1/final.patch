--- a/src/promise/withTimeout.ts
+++ b/src/promise/withTimeout.ts
@@ -1,4 +1,4 @@
-import { timeout } from './timeout.ts';
+import { TimeoutError } from '../error/TimeoutError.ts';
 
 interface WithTimeoutOptions {
   signal?: AbortSignal;
@@ -47,5 +47,29 @@ export async function withTimeout<T>(
   ms: number,
   { signal }: WithTimeoutOptions = {}
 ): Promise<T> {
-  return Promise.race([run(), timeout(ms, { signal })]);
+  if (signal?.aborted) {
+    return run();
+  }
+
+  let timeoutId: ReturnType<typeof setTimeout> | undefined;
+
+  const onAbort = () => {
+    clearTimeout(timeoutId);
+    timeoutId = undefined;
+  };
+
+  const deadline = new Promise<never>((_resolve, reject) => {
+    timeoutId = setTimeout(() => {
+      signal?.removeEventListener('abort', onAbort);
+      reject(new TimeoutError());
+    }, ms);
+    signal?.addEventListener('abort', onAbort, { once: true });
+  });
+
+  try {
+    return await Promise.race([run(), deadline]);
+  } finally {
+    clearTimeout(timeoutId);
+    signal?.removeEventListener('abort', onAbort);
+  }
 }
