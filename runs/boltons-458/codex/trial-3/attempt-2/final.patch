diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..d6d654a 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,30 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
+
+
+@pytest.mark.parametrize('dict_type', [OMD, URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('iterable', [list, tuple, iter, lambda v: (x for x in v)])
+def test_addlist_iterables(dict_type, iterable):
+    omd = dict_type()
+    omd.addlist('empty', iterable([]))
+    assert 'empty' not in omd
+    assert len(omd) == 0
+
+    omd.addlist('a', iterable(range(2)))
+    omd.add('b', 9)
+    omd.add('a', 2)
+    omd.addlist('a', iterable(range(3, 5)))
+    omd.addlist('a', iterable([]))
+
+    assert omd.getlist('a') == [0, 1, 2, 3, 4]
+    assert omd.get('a') == omd['a'] == 4
+    assert omd.items(multi=True) == [
+        ('a', 0), ('a', 1), ('b', 9), ('a', 2), ('a', 3), ('a', 4)]
+    assert omd.todict(multi=True) == {'a': [0, 1, 2, 3, 4], 'b': [9]}
+    assert omd.poplast('a') == 4
+    assert omd.getlist('a') == [0, 1, 2, 3]
 
 
 _ITEMSETS = [[],
