+def test_query_params_addlist_iterator():
+    url = URL('https://example.com/?a=0')
+    url.query_params.addlist('a', (str(value) for value in range(1, 3)))
+    url.query_params.addlist('empty', iter([]))
+    assert url.query_params.getlist('a') == ['0', '1', '2']
+    assert url.query_params.get('a') == '2'
+    assert url.query_params.to_text() == 'a=0&a=1&a=2'
+    assert url.to_text() == 'https://example.com/?a=0&a=1&a=2'
