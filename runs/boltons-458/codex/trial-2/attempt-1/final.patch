 import sys
+import runpy
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons import urlutils
 
 
 _ITEMSETS = [[],
@@ -270,6 +272,37 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [
+    OMD,
+    urlutils.QueryParamDict,
+    runpy.run_path(urlutils.__file__)['OrderedMultiDict'],
+], ids=['dictutils', 'query_params', 'standalone_urlutils'])
+@pytest.mark.parametrize('iterable_type', [list, tuple, lambda v: v, iter,
+                                         lambda v: (x for x in v)],
+                         ids=['list', 'tuple', 'range', 'iterator', 'generator'])
+def test_addlist_iterables(omd_type, iterable_type):
+    omd = omd_type()
+    omd.add('a', -1)
+    omd.addlist('a', [0])
+    omd.add('b', 9)
+    omd.addlist('a', iterable_type(range(1, 3)))
+
+    assert omd.getlist('a') == [-1, 0, 1, 2]
+    assert omd.get('a') == omd['a'] == 2
+    assert omd.items(multi=True) == [('a', -1), ('a', 0), ('b', 9),
+                                     ('a', 1), ('a', 2)]
+    assert omd.values(multi=True) == [-1, 0, 9, 1, 2]
+    assert omd.poplast('a') == 2
+    assert omd.getlist('a') == [-1, 0, 1]
+
+    before = omd.items(multi=True)
+    omd.addlist('a', iterable_type(range(0)))
+    omd.addlist('missing', iterable_type(range(0)))
+    assert 'missing' not in omd
+    assert omd.items(multi=True) == before
+    assert omd.getlist('a') == [-1, 0, 1]
+
+
 def test_pop_all():
     omd = OMD()
     omd.add('even', 0)
