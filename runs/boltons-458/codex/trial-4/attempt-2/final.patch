diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..1e4ad44 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -1,7 +1,8 @@
 import sys
 import pytest
 
-from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import OMD, FastIterOrderedMultiDict, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +271,33 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict,
+                                       URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('make_values', [list, tuple, range, iter,
+                                       lambda values: (v for v in values)])
+def test_addlist_iterables(dict_type, make_values):
+    omd = dict_type()
+    omd.add('a', -1)
+    omd.addlist('a', [0])
+    omd.add('b', 9)
+    # range takes a stop argument; the other factories take an iterable.
+    values = make_values(3) if make_values is range else make_values(range(3))
+    omd.addlist('a', values)
+
+    assert omd.getlist('a') == [-1, 0, 0, 1, 2]
+    assert omd.get('a') == omd['a'] == 2
+    assert omd.items(multi=True) == [('a', -1), ('a', 0), ('b', 9),
+                                     ('a', 0), ('a', 1), ('a', 2)]
+    assert omd.todict(multi=True) == {'a': [-1, 0, 0, 1, 2], 'b': [9]}
+
+    empty = make_values(0) if make_values is range else make_values([])
+    omd.addlist('missing', empty)
+    assert 'missing' not in omd
+    omd.addlist('a', iter([]))
+    assert omd.popall('a') == [-1, 0, 0, 1, 2]
+    assert omd.items(multi=True) == [('b', 9)]
+
+
 def test_pop_all():
     omd = OMD()
     omd.add('even', 0)
