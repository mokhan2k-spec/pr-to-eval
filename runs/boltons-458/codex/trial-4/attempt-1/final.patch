diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..347362b 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,43 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
+
+
+@pytest.mark.parametrize('omd_type', [OMD, URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('iterable_type', [list, tuple, range, iter,
+                                         lambda values: (v for v in values)])
+def test_addlist_iterables(omd_type, iterable_type):
+    omd = omd_type()
+    omd.add('a', -1)
+    omd.addlist('a', [0])
+    omd.add('b', 9)
+    values = range(1, 3)
+    omd.addlist('a', iterable_type(1, 3) if iterable_type is range
+                else iterable_type(values))
+
+    assert omd.getlist('a') == [-1, 0, 1, 2]
+    assert omd.get('a') == omd['a'] == 2
+    assert omd.items(multi=True) == [('a', -1), ('a', 0), ('b', 9),
+                                     ('a', 1), ('a', 2)]
+    assert omd.todict(multi=True) == {'a': [-1, 0, 1, 2], 'b': [9]}
+    assert omd.poplast('a') == 2
+    assert omd.getlist('a') == [-1, 0, 1]
+
+
+@pytest.mark.parametrize('omd_type', [OMD, URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('make_empty', [list, tuple, lambda: range(0),
+                                       lambda: iter(()), lambda: (v for v in ())])
+def test_addlist_empty_iterables(omd_type, make_empty):
+    omd = omd_type([('a', 1)])
+    omd.addlist('missing', make_empty())
+    omd.addlist('a', make_empty())
+
+    assert 'missing' not in omd
+    assert omd.get('missing') is None
+    assert list(omd) == ['a']
+    assert omd.items(multi=True) == [('a', 1)]
+    assert omd.getlist('a') == [1]
 
 
 _ITEMSETS = [[],
