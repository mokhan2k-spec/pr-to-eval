+def test_query_params_addlist_iterator():
+    url = URL('https://example.com/?a=0')
+    url.query_params.addlist('a', (str(v) for v in range(1, 3)))
+    url.query_params.addlist('missing', iter([]))
+
+    assert url.query_params.getlist('a') == ['0', '1', '2']
