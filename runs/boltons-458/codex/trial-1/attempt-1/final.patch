diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..72c82ab 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,8 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +272,32 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict,
+                                    URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('iterable', [list, tuple, iter,
+                                    lambda values: (v for v in values)])
+def test_addlist_iterables(omd_type, iterable):
+    omd = omd_type()
+    omd.add('a', -1)
+    omd.addlist('a', iterable(range(2)))
+    omd.add('b', 9)
+    omd.addlist('a', iterable(range(2, 4)))
+
+    assert omd.getlist('a') == [-1, 0, 1, 2, 3]
+    assert omd.get('a') == omd['a'] == 3
+    assert omd.items(multi=True) == [
+        ('a', -1), ('a', 0), ('a', 1), ('b', 9), ('a', 2), ('a', 3)]
+    assert omd.todict(multi=True) == {'a': [-1, 0, 1, 2, 3], 'b': [9]}
+
+    omd.addlist('missing', iterable([]))
+    omd.addlist('a', iterable([]))
+    assert 'missing' not in omd
+    assert omd.keys() == ['a', 'b']
+    assert omd.getlist('a') == [-1, 0, 1, 2, 3]
+    assert omd.popall('a') == [-1, 0, 1, 2, 3]
+    assert omd.items(multi=True) == [('b', 9)]
+
+
 def test_pop_all():
     omd = OMD()
     omd.add('even', 0)
