+def test_query_params_addlist_iterator():
+    url = URL('https://example.com/?a=0')
+    url.query_params.addlist('a', (str(value) for value in [1, 2]))
+    url.query_params.addlist('missing', iter([]))
+    assert url.query_params.getlist('a') == ['0', '1', '2']
+    assert url.to_text() == 'https://example.com/?a=0&a=1&a=2'
+
+
 def test_iri_query():
     url = URL('http://minerals.mountain.ore/?rock=\N{SHAMROCK}')
     assert url.query_params['rock'] == '\N{SHAMROCK}'
