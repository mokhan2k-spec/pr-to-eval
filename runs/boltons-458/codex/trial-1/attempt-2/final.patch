diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..3a65683 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,8 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +272,35 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('dict_type', [OMD, FastIterOrderedMultiDict,
+                                      URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('iterable', [list, tuple, range, iter,
+                                    lambda values: (v for v in values)])
+def test_addlist_iterables(dict_type, iterable):
+    # range takes a stop value rather than an iterable.
+    make_values = lambda: range(3) if iterable is range else iterable([0, 1, 2])
+    omd = dict_type()
+    omd.addlist('a', make_values())
+    omd.add('b', 9)
+    omd.add('a', -1)
+    omd.addlist('a', make_values())
+
+    assert omd.getlist('a') == [0, 1, 2, -1, 0, 1, 2]
+    assert omd.get('a') == omd['a'] == 2
+    assert omd.items(multi=True) == [('a', 0), ('a', 1), ('a', 2),
+                                     ('b', 9), ('a', -1),
+                                     ('a', 0), ('a', 1), ('a', 2)]
+    assert omd.todict(multi=True) == {'a': [0, 1, 2, -1, 0, 1, 2], 'b': [9]}
+    assert omd.poplast('a') == 2
+    assert omd.getlist('a') == [0, 1, 2, -1, 0, 1]
+
+    empty = range(0) if iterable is range else iterable([])
+    omd.addlist('missing', empty)
+    assert 'missing' not in omd
+    assert omd.get('missing', 'default') == 'default'
+    assert all(key != 'missing' for key, value in omd.items(multi=True))
+
+
