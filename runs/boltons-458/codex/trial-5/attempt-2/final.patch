diff --git a/tests/test_dictutils.py b/tests/test_dictutils.py
index c82a4a2..ab2a1e0 100644
--- a/tests/test_dictutils.py
+++ b/tests/test_dictutils.py
@@ -2,6 +2,8 @@ import sys
 import pytest
 
 from boltons.dictutils import OMD, OneToOne, ManyToMany, FrozenDict, subdict, FrozenHashError
+from boltons.dictutils import FastIterOrderedMultiDict
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict, QueryParamDict
 
 
 _ITEMSETS = [[],
@@ -270,6 +272,38 @@ def test_addlist():
     assert len(list(e_omd.iteritems(multi=True))) == 0
 
 
+@pytest.mark.parametrize('omd_type', [OMD, FastIterOrderedMultiDict,
+                                     URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('iterable_type', [list, tuple, range, iter,
+                                         lambda values: (v for v in values)])
+def test_addlist_iterables(omd_type, iterable_type):
+    def make_values(start, stop):
+        if iterable_type is range:
+            return range(start, stop)
+        return iterable_type(range(start, stop))
+
+    omd = omd_type()
+    omd.addlist('empty', make_values(0, 0))
+    assert 'empty' not in omd
+    assert omd.items(multi=True) == []
+    assert len(omd) == 0
+
+    omd.add('a', -1)
+    omd.addlist('a', make_values(0, 2))
+    omd.add('b', 9)
+    omd.addlist('a', make_values(2, 4))
+    omd.addlist('a', make_values(0, 0))
+
+    assert omd.getlist('a') == [-1, 0, 1, 2, 3]
+    assert omd.get('a') == omd['a'] == 3
+    assert omd.items(multi=True) == [('a', -1), ('a', 0), ('a', 1),
+                                     ('b', 9), ('a', 2), ('a', 3)]
+    assert omd.todict(multi=True) == {'a': [-1, 0, 1, 2, 3], 'b': [9]}
+    assert omd.poplast('a') == 3
+    assert omd.getlist('a') == [-1, 0, 1, 2]
+    assert omd.get('a') == 2
+
+
 def test_pop_all():
     omd = OMD()
     omd.add('even', 0)
diff --git a/tests/test_urlutils.py b/tests/test_urlutils.py
index 8cac423..baacc42 100644
--- a/tests/test_urlutils.py
+++ b/tests/test_urlutils.py
@@ -95,6 +95,17 @@ def test_query_params(test_url):
     assert test_url.endswith(qp_text)
 
 
+def test_query_params_addlist_iterator():
+    url = URL('https://example.com/?a=0')
+    url.query_params.addlist('a', iter(['1', '2']))
+    url.query_params.addlist('b', (str(v) for v in range(3, 5)))
+    url.query_params.addlist('empty', iter([]))
+
+    assert url.query_params.getlist('a') == ['0', '1', '2']
+    assert url.query_params.get('b') == '4'
+    assert url.to_text() == 'https://example.com/?a=0&a=1&a=2&b=3&b=4'
+
+
 def test_query_param_dict_eq_with_dict():
     qpd = QueryParamDict([('a', '1'), ('b', '2')])
     assert qpd == {'a': '1', 'b': '2'}
