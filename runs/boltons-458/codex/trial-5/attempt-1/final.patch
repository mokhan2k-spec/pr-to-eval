@@ -0,0 +1,45 @@
+import pytest
+
+from boltons.dictutils import OrderedMultiDict, FastIterOrderedMultiDict
+from boltons.urlutils import OrderedMultiDict as URLOrderedMultiDict
+from boltons.urlutils import QueryParamDict, URL
+
+
+@pytest.mark.parametrize('dict_type', [OrderedMultiDict, FastIterOrderedMultiDict,
+                                      URLOrderedMultiDict, QueryParamDict])
+@pytest.mark.parametrize('make_values', [list, tuple, range, iter,
+                                        lambda values: (v for v in values)])
+def test_addlist_iterables(dict_type, make_values):
+    # range needs a stop argument; all factories yield 0, 1, 2.
+    values = make_values(3) if make_values is range else make_values(range(3))
+    omd = dict_type()
+    omd.add('a', -2)
+    omd.addlist('a', [-1])
+    omd.add('b', 10)
+    omd.addlist('a', values)
+
+    assert omd.getlist('a') == [-2, -1, 0, 1, 2]
+    assert omd.get('a') == omd['a'] == 2
+    assert omd.keys() == ['a', 'b']
+    assert omd.items(multi=True) == [('a', -2), ('a', -1), ('b', 10),
+                                     ('a', 0), ('a', 1), ('a', 2)]
+    assert omd.values(multi=True) == [-2, -1, 10, 0, 1, 2]
+    assert omd.poplast('a') == 2
+    assert omd.popall('a') == [-2, -1, 0, 1]
+    assert omd.items(multi=True) == [('b', 10)]
+
+    empty = make_values(0) if make_values is range else make_values([])
+    omd.addlist('missing', empty)
+    assert 'missing' not in omd
+    assert len(omd) == 1
+    assert omd.items(multi=True) == [('b', 10)]
+
+
+def test_url_query_addlist_generator():
+    url = URL('https://example.com/?a=first&b=other')
+    url.query_params.addlist('a', (v for v in ['second', 'third']))
+    url.query_params.addlist('missing', iter([]))
+
+    assert url.query_params.getlist('a') == ['first', 'second', 'third']
+    assert url.query_params.get('a') == 'third'
+    assert url.to_text() == 'https://example.com/?a=first&b=other&a=second&a=third'
