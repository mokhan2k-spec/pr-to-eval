diff --git a/src/promise/withTimeout.ts b/src/promise/withTimeout.ts
index 4e6ba6e..4f65f87 100644
--- a/src/promise/withTimeout.ts
+++ b/src/promise/withTimeout.ts
@@ -47,5 +47,19 @@ export async function withTimeout<T>(
   ms: number,
   { signal }: WithTimeoutOptions = {}
 ): Promise<T> {
-  return Promise.race([run(), timeout(ms, { signal })]);
+  const controller = new AbortController();
+  const abortHandler = () => controller.abort();
+
+  if (signal?.aborted) {
+    controller.abort();
+  } else {
+    signal?.addEventListener('abort', abortHandler, { once: true });
+  }
+
+  try {
+    return await Promise.race([run(), timeout(ms, { signal: controller.signal })]);
+  } finally {
+    controller.abort();
+    signal?.removeEventListener('abort', abortHandler);
+  }
 }
