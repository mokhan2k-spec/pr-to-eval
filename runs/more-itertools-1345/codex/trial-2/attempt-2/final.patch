+    def test_hash_long_ranges(self):
+        for size in (sys.maxsize, sys.maxsize + 1, 10**30):
+            for args in ((0, size), (0, 2 * size, 2), (0, -size, -1)):
+                with self.subTest(args=args):
+                    r = mi.numeric_range(*args)
+                    self.assertEqual(hash(r), hash(range(*args)))
+                    if size > sys.maxsize:
+                        self.assertRaises(OverflowError, len, r)
+                    else:
+                        self.assertEqual(len(r), size)
