diff --git a/tests/test_more.py b/tests/test_more.py
index 45ceaeb..10a202a 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -2935,6 +2935,29 @@ class NumericRangeTests(TestCase):
                 self.assertNotIn(v, r)
                 self.assertRaises(ValueError, r.index, v)
 
+    def test_long_ranges(self):
+        stop = 10**30
+        for args1, args2 in [
+            ((0, stop), (0, stop, 1)),
+            ((0, stop, 2), (0, stop - 1, 2)),
+            ((0, -stop, -2), (0, -stop + 1, -2)),
+        ]:
+            with self.subTest(args1=args1, args2=args2):
+                range1 = mi.numeric_range(*args1)
+                range2 = mi.numeric_range(*args2)
+                self.assertEqual(range1, range2)
+                self.assertFalse(range1 != range2)
+                self.assertEqual(hash(range1), hash(range2))
+                self.assertEqual(hash(range(*args1)), hash(range1))
+                self.assertEqual({range1: 1}[range2], 1)
+                self.assertEqual(len({range1, range2}), 1)
+                self.assertRaises(OverflowError, len, range1)
+
+        for args in [(0, stop - 1), (1, stop + 1), (0, stop, 2)]:
+            self.assertNotEqual(
+                mi.numeric_range(0, stop), mi.numeric_range(*args)
+            )
+
     def test_eq(self):
         # numeric_range objects are equal to themselves
         range_1 = mi.numeric_range(2, 4, 1)
