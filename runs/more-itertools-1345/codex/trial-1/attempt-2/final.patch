+    def test_eq_and_hash_large_ranges(self):
+        stop = 10**30
+        for args1, args2 in [
+            ((0, stop, 2), (0, stop - 1, 2)),
+            ((0, -stop, -2), (0, -stop + 1, -2)),
+            (
+                (Fraction(0), stop, Fraction(1, 2)),
+                (Fraction(0), stop, Fraction(1, 2)),
+            ),
+        ]:
+            with self.subTest(args1=args1, args2=args2):
+                range1 = mi.numeric_range(*args1)
+                range2 = mi.numeric_range(*args2)
+                self.assertEqual(range1, range2)
+                self.assertFalse(range1 != range2)
+                self.assertEqual(hash(range1), hash(range2))
+                self.assertEqual({range1: 'value'}[range2], 'value')
+                self.assertEqual(len({range1, range2}), 1)
+                self.assertRaises(OverflowError, len, range1)
+
+        for args in [
+            (0, stop - 2, 2),
+            (1, stop, 2),
+            (0, stop * 2, 4),
+            (0, -stop, -2),
+            (0, 10, 2),
+        ]:
+            with self.subTest(args=args):
+                self.assertNotEqual(
+                    mi.numeric_range(0, stop, 2), mi.numeric_range(*args)
+                )
+
+    def test_hash_matches_builtin_range(self):
+        for args in [
+            (0,),
+            (2, 3, 5),
+            (0, sys.maxsize),
+            (0, sys.maxsize + 1),
+            (0, 10**30, 2),
+            (0, -10**30, -2),
+        ]:
+            with self.subTest(args=args):
+                self.assertEqual(hash(mi.numeric_range(*args)), hash(range(*args)))
