+    def test_eq_and_hash_large_ranges(self):
+        stop = 10**30
+        for args1, args2 in [
+            ((0, stop), (0, stop, 1)),
+            ((0, stop, 2), (0, stop - 1, 2)),
+            ((0, -stop, -2), (0, -stop + 1, -2)),
+        ]:
+            with self.subTest(args1=args1, args2=args2):
+                range1 = mi.numeric_range(*args1)
+                range2 = mi.numeric_range(*args2)
+                self.assertEqual(range1, range2)
+                self.assertFalse(range1 != range2)
+                self.assertEqual(hash(range1), hash(range2))
+                self.assertEqual(hash(range(*args1)), hash(range1))
+                self.assertEqual('value', {range1: 'value'}[range2])
+                self.assertEqual(1, len({range1, range2}))
+                with self.assertRaises(OverflowError):
+                    len(range1)
+
+        for args in [
+            (0, stop + 1),  # Different length
+            (1, stop + 1),  # Different start, same length
+            (0, 2 * stop, 2),  # Different step, same length
+            (0, -stop, -1),  # Different direction, same length
+        ]:
+            with self.subTest(args=args):
+                range1 = mi.numeric_range(0, stop)
+                range2 = mi.numeric_range(*args)
+                self.assertNotEqual(range1, range2)
+                self.assertFalse(range1 == range2)
