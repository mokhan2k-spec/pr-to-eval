+    def test_oversized_ranges(self):
+        size = 10**30
+        for args, equal_args, unequal_args in [
+            ((0, size), (0, size, 1), (0, size + 1)),
+            ((0, size, 2), (0, size - 1, 2), (0, size, 3)),
+            ((0, -size, -2), (0, -size + 1, -2), (0, -size, -3)),
+            ((0, size), (0, size, 1), (1, size + 1)),
+        ]:
+            with self.subTest(args=args, unequal_args=unequal_args):
+                r = mi.numeric_range(*args)
+                equal = mi.numeric_range(*equal_args)
+                unequal = mi.numeric_range(*unequal_args)
+                self.assertTrue(r == equal)
+                self.assertFalse(r != equal)
+                self.assertFalse(r == unequal)
+                self.assertTrue(r != unequal)
+                self.assertEqual(hash(r), hash(equal))
+                self.assertEqual(hash(r), hash(range(*args)))
+                self.assertEqual({r: 'value'}[equal], 'value')
+                self.assertEqual(len({r, equal}), 1)
+                self.assertRaises(OverflowError, len, r)
+
