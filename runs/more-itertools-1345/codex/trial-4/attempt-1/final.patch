 class NumericRangeTests(TestCase):
+    def test_large_range_equality(self):
+        stop = 10**30
+        for args, other_args in [
+            ((0, stop, 2), (0, stop - 1, 2)),
+            ((0, -stop, -2), (0, -stop + 1, -2)),
+            ((0, stop), (0, stop - 1)),
+            ((0, stop, 2), (1, stop, 2)),
+            ((0, stop, 2), (0, 2 * stop, 4)),
+        ]:
+            with self.subTest(args=args, other_args=other_args):
+                a = mi.numeric_range(*args)
+                b = mi.numeric_range(*other_args)
+                expected = range(*args) == range(*other_args)
+                self.assertEqual(a == b, expected)
+                self.assertEqual(a != b, not expected)
+                self.assertEqual(b == a, expected)
+
+    def test_large_range_hash(self):
+        stop = 10**30
+        for args, other_args in [
+            ((0, stop), (0, stop)),
+            ((0, stop, 2), (0, stop - 1, 2)),
+            ((0, -stop, -2), (0, -stop + 1, -2)),
+        ]:
+            with self.subTest(args=args):
+                a = mi.numeric_range(*args)
+                b = mi.numeric_range(*other_args)
+                self.assertEqual(hash(a), hash(range(*args)))
+                self.assertEqual(hash(a), hash(b))
+                self.assertEqual({a: 'value'}[b], 'value')
+                self.assertEqual(len({a, b}), 1)
+                with self.assertRaises(OverflowError):
+                    len(a)
