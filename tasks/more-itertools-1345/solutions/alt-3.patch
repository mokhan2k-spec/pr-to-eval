@@ -2454,6 +2454,24 @@ class numeric_range(Sequence):
                 n += 1
             return n
 
+    def _count(self):
+        # Number of items; unlike len(), not limited to sys.maxsize.
+        if self._growing:
+            distance = self._stop - self._start
+            step = self._step
+        else:
+            distance = self._start - self._stop
+            step = -self._step
+        if distance <= self._zero:
+            return 0
+        q, r = divmod(distance, step)
+        n = int(q) + int(r != self._zero)
+        while n and not self._before_stop(n - 1):
+            n -= 1
+        while self._before_stop(n):
+            n += 1
+        return n
+
     def _before_stop(self, i):
         value = self._start + i * self._step
         return value < self._stop if self._growing else value > self._stop
